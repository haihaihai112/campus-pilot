MODEL_MODE=live
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=  (also accepts DASHSCOPE_API_KEY from environment)
# Any OpenAI-compatible endpoint works; the model must support native tool_calls.
# DeepSeek example (verified end to end on 2026-09-21):
#   LLM_MODEL=deepseek-chat
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-...
CAMPUS_DATA_PROFILE=whut-2026
# Leave unset to use today's Asia/Shanghai date. Historical replay only:
# DEMO_DATE=2026-09-05
RETRIEVER_BACKEND=memory
RAG_MCP_URL=http://127.0.0.1:8030/mcp
CAMPUS_MCP_URL=http://127.0.0.1:8040/mcp
PLANNER_URL=http://127.0.0.1:8020
# Local demo credentials only. Replace all three before using on any shared network.
MCP_READ_TOKEN=local-demo-read
MCP_WRITE_TOKEN=local-demo-write
A2A_TOKEN=local-demo-a2a
# External tools: use an Amap Web service key; never paste secrets into chat.
AMAP_API_KEY=
# Individual reporting locations are unverified. Optional reviewed local JSON path:
CAMPUS_LOCATIONS_FILE=
# Adapter interface only; no provider is bundled yet.
CALENDAR_PROVIDER=none
# demo: local single identity. pilot: invite-only accounts and user data isolation.
AUTH_MODE=demo
# true for HTTPS; false ONLY for local HTTP testing.
COOKIE_SECURE=true
LOGIN_TTL_HOURS=24
REQUESTS_PER_MINUTE=240
TURNS_PER_HOUR=20
MAX_ACTIVE_TURNS=4
MAX_PENDING_TURNS=32
MAX_PENDING_PER_USER=2
# MILVUS_URI=http://127.0.0.1:19530
# BGE_M3_PATH=/models/bge-m3
# BGE_RERANKER_PATH=/models/bge-reranker-v2-m3
